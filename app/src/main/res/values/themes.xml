<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window theme, which matters more than it looks like it does: this is
      what the system draws for the ~200ms between tapping the icon and the first
      Compose frame. A black window under a black app is the difference between
      "instant" and "it flashed something".
    -->
    <style name="Theme.UltronWear" parent="@android:style/Theme.DeviceDefault">
        <item name="android:colorPrimary">@color/ultron_accent</item>
        <item name="android:colorPrimaryDark">@color/ultron_accent_dim</item>
        <item name="android:colorAccent">@color/ultron_accent_bright</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/ultron_text</item>
        <item name="android:textColorSecondary">@color/ultron_text_dim</item>
    </style>

    <style name="Theme.UltronWear.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.UltronWear</item>
    </style>
</resources>
