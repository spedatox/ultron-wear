# Gradle files
.gradle/
build/
/app/build/

# Local configuration — SDK path AND the Igor base URL / API key that
# build.gradle.kts injects into BuildConfig. Never commit this.
local.properties

# Firebase client config. Not strictly a secret (it is client-side config, and
# the API key in it is origin-restricted), but it names the project and is
# regenerated per developer, so it stays out of the repo. Without it the app
# still builds and runs — push is simply disabled. See docs/ULTRON_WEAR.md.
app/google-services.json

